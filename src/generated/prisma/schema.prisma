generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                   @id @default(uuid())
  email               String                   @unique
  passwordHash        String
  firstName           String
  lastName            String
  username            String?                  @unique
  displayName         String?
  phone               String?                  @unique
  country             String?
  countryCode         String?
  gender              String?
  dateOfBirth         DateTime?
  bio                 String?
  address             String?
  profileImageUrl     String?
  isEmailVerified     Boolean                  @default(false)
  isProfileComplete   Boolean                  @default(false)
  isVerified          Boolean                  @default(false)
  isActive            Boolean                  @default(true)
  role                UserRole                 @default(USER)
  transactionPinHash  String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  passwordResets      PasswordResetChallenge[]
  pendingVerification PendingRegistration?
  refreshSessions     RefreshSession[]
}

model PendingRegistration {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  country        String?
  countryCode    String?
  gender         String?
  otpHash        String
  otpExpiresAt   DateTime
  otpAttempts    Int       @default(0)
  lastOtpSentAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  existingUserId String?   @unique
  existingUser   User?     @relation(fields: [existingUserId], references: [id], onDelete: Cascade)

  @@index([otpExpiresAt])
}

model PasswordResetChallenge {
  id         String    @id @default(uuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model RefreshSession {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

enum UserRole {
  USER
  ADMIN
}
