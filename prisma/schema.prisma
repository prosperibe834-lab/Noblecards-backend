generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                   @id @default(uuid())
  email               String                   @unique
  passwordHash        String
  firstName           String
  lastName            String
  username            String?                  @unique
  displayName         String?
  phone               String?                  @unique
  country             String?
  countryCode         String?
  gender              String?
  dateOfBirth         DateTime?
  bio                 String?
  address             String?
  profileImageUrl     String?
  isEmailVerified     Boolean                  @default(false)
  isProfileComplete   Boolean                  @default(false)
  isVerified          Boolean                  @default(false)
  isActive            Boolean                  @default(true)
  role                UserRole                 @default(USER)
  transactionPinHash  String?
  transactionPinFailedAttempts Int              @default(0)
  transactionPinLockedUntil DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  passwordResets      PasswordResetChallenge[]
  pendingVerification PendingRegistration?
  refreshSessions     RefreshSession[]
  wallet              Wallet?
  deposits            Deposit[]
  transactions        Transaction[]
  withdrawals         Withdrawal[]
  withdrawalQuotes    WithdrawalQuote[]
  beneficiaries       Beneficiary[]
}

model PendingRegistration {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  country        String?
  countryCode    String?
  gender         String?
  otpHash        String
  otpExpiresAt   DateTime
  otpAttempts    Int       @default(0)
  lastOtpSentAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  existingUserId String?   @unique
  existingUser   User?     @relation(fields: [existingUserId], references: [id], onDelete: Cascade)

  @@index([otpExpiresAt])
}

model PasswordResetChallenge {
  id         String    @id @default(uuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model RefreshSession {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Wallet {
  id             String          @id @default(uuid())
  userId         String          @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  balances       WalletBalance[]
  deposits       Deposit[]
  transactions   Transaction[]
  ledgerEntries  LedgerEntry[]
  withdrawals    Withdrawal[]

  @@index([userId])
}

model Currency {
  code                    String             @id @db.VarChar(10)
  name                    String
  symbol                  String?
  country                 String?
  region                  String?
  flag                    String?
  enabled                 Boolean            @default(true)
  depositEnabled         Boolean            @default(false)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  balances                WalletBalance[]
  deposits                Deposit[]
  transactions            Transaction[]
  ledgerEntries           LedgerEntry[]
  sourceWithdrawals       Withdrawal[]       @relation("WithdrawalSourceCurrency")
  destinationWithdrawals  Withdrawal[]       @relation("WithdrawalDestinationCurrency")
  sourceQuotes             WithdrawalQuote[]  @relation("QuoteSourceCurrency")
  destinationQuotes        WithdrawalQuote[]  @relation("QuoteDestinationCurrency")
  beneficiaries            Beneficiary[]

  @@index([enabled, depositEnabled])
}

model WalletBalance {
  id               String   @id @default(uuid())
  walletId         String
  currencyCode     String
  availableBalance Decimal  @default(0.00) @db.Decimal(18, 2)
  pendingBalance   Decimal  @default(0.00) @db.Decimal(18, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  wallet           Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  currency         Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  @@unique([walletId, currencyCode])
  @@index([walletId, currencyCode])
}

model Deposit {
  id                     String            @id @default(uuid())
  userId                 String
  walletId               String
  currencyCode           String
  amount                 Decimal           @db.Decimal(18, 2)
  fee                    Decimal           @default(0.00) @db.Decimal(18, 2)
  netAmount              Decimal           @db.Decimal(18, 2)
  exchangeRate           Decimal?          @db.Decimal(18, 8)
  provider               PaymentProvider   @default(FLUTTERWAVE)
  providerTransactionId  String?
  providerReference      String?
  paymentMethod          PaymentMethod?
  country                String?
  countryCode            String?
  status                 DepositStatus     @default(PENDING)
  idempotencyKey         String?
  metadata               Json?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  transactionId          String?           @unique
  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet                 Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  currency               Currency          @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  transaction            Transaction?      @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([userId, status, createdAt])
  @@index([walletId, status])
  @@index([provider, providerTransactionId])
  @@index([currencyCode, status])
}

model Transaction {
  id                    String          @id @default(uuid())
  userId                String
  walletId              String
  currencyCode          String
  type                  TransactionType @default(DEPOSIT)
  amount                Decimal         @db.Decimal(18, 2)
  fee                   Decimal         @default(0.00) @db.Decimal(18, 2)
  netAmount             Decimal         @db.Decimal(18, 2)
  status                TransactionStatus @default(PENDING)
  provider              PaymentProvider?
  providerTransactionId String?
  providerReference     String?
  paymentMethod         PaymentMethod?
  reference             String          @unique
  metadata              Json?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet                Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  currency              Currency        @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  deposit               Deposit?
  withdrawal            Withdrawal?
  ledgerEntries         LedgerEntry[]

  @@index([userId, status, createdAt])
  @@index([walletId, status])
  @@index([provider, providerTransactionId])
}

model LedgerEntry {
  id                    String      @id @default(uuid())
  walletId              String
  currencyCode          String
  transactionId         String?
  type                  LedgerEntryType
  amount                Decimal     @db.Decimal(18, 2)
  balanceBefore         Decimal     @db.Decimal(18, 2)
  balanceAfter          Decimal     @db.Decimal(18, 2)
  pendingBalanceBefore  Decimal?    @db.Decimal(18, 2)
  pendingBalanceAfter   Decimal?    @db.Decimal(18, 2)
  operationKey          String?     @unique
  reference             String?
  reason                String?
  createdAt             DateTime    @default(now())
  wallet                Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  currency              Currency    @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  transaction           Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([walletId, currencyCode, createdAt])
  @@index([transactionId])
}

model Withdrawal {
  id                    String          @id @default(uuid())
  reference             String          @unique
  userId                String
  walletId              String
  transactionId         String          @unique
  sourceCurrencyCode    String
  destinationCurrencyCode String
  sourceAmount          Decimal         @db.Decimal(18, 2)
  destinationAmount     Decimal         @db.Decimal(18, 2)
  exchangeRate          Decimal         @db.Decimal(18, 8)
  fee                   Decimal         @db.Decimal(18, 2)
  amountReceived        Decimal         @db.Decimal(18, 2)
  country               String
  countryCode           String
  paymentMethod         PaymentMethod
  provider              PaymentProvider?
  providerReference     String?
  providerTransactionId String?
  quoteId               String?
  beneficiaryId         String?
  idempotencyKey        String
  status                TransactionStatus @default(PENDING)
  failureReason         String?
  metadata              Json?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  completedAt           DateTime?
  user                  User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet                Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  transaction           Transaction     @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  sourceCurrency        Currency        @relation("WithdrawalSourceCurrency", fields: [sourceCurrencyCode], references: [code], onDelete: Restrict)
  destinationCurrency   Currency        @relation("WithdrawalDestinationCurrency", fields: [destinationCurrencyCode], references: [code], onDelete: Restrict)
  quote                 WithdrawalQuote? @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  beneficiary           Beneficiary?    @relation(fields: [beneficiaryId], references: [id], onDelete: Restrict)
  payoutAttempts        PayoutAttempt[]
  webhookEvents         ProviderWebhookEvent[]

  @@unique([userId, idempotencyKey])
  @@unique([provider, providerReference])
  @@unique([provider, providerTransactionId])
  @@index([userId, status, createdAt])
  @@index([walletId, status, createdAt])
  @@index([status, createdAt])
  @@index([provider, providerReference])
  @@index([provider, providerTransactionId])
  @@index([quoteId])
  @@index([beneficiaryId])
}

model WithdrawalQuote {
  id                    String              @id @default(uuid())
  userId                String
  sourceCurrencyCode    String
  destinationCurrencyCode String
  countryCode           String
  paymentMethod         PaymentMethod
  sourceAmount          Decimal             @db.Decimal(18, 2)
  exchangeRate          Decimal             @db.Decimal(18, 8)
  destinationAmount     Decimal             @db.Decimal(18, 2)
  idempotencyKey        String?
  providerFee           Decimal             @default(0.00) @db.Decimal(18, 2)
  nobleCardsFee         Decimal             @default(0.00) @db.Decimal(18, 2)
  totalFee              Decimal             @default(0.00) @db.Decimal(18, 2)
  destinationFee        Decimal             @default(0.00) @db.Decimal(18, 2)
  recipientAmount       Decimal             @db.Decimal(18, 2)
  amountReceived        Decimal             @db.Decimal(18, 2)
  status                WithdrawalQuoteStatus @default(ACTIVE)
  createdAt             DateTime            @default(now())
  expiresAt             DateTime
  usedAt                DateTime?
  user                  User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  sourceCurrency        Currency            @relation("QuoteSourceCurrency", fields: [sourceCurrencyCode], references: [code], onDelete: Restrict)
  destinationCurrency   Currency            @relation("QuoteDestinationCurrency", fields: [destinationCurrencyCode], references: [code], onDelete: Restrict)
  withdrawals           Withdrawal[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([userId, status, expiresAt])
  @@index([expiresAt])
}

model Beneficiary {
  id                       String                     @id @default(uuid())
  userId                   String
  country                  String
  countryCode              String
  currencyCode             String
  paymentMethod            PaymentMethod
  type                     BeneficiaryType
  institutionName          String?
  providerBankCode         String?
  accountHolderName        String?
  accountLast4             String?
  mobileMoneyProvider      String?
  providerRecipientReference String?
  encryptedDetails         Json?
  detailsFingerprint       String?
  verificationStatus       BeneficiaryVerificationStatus @default(UNVERIFIED)
  verifiedAt               DateTime?
  isActive                 Boolean                    @default(true)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  user                     User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  currency                 Currency                   @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  withdrawals              Withdrawal[]

  @@index([userId, createdAt])
  @@index([userId, countryCode, currencyCode, paymentMethod])
  @@index([verificationStatus])
  @@unique([userId, providerRecipientReference])
}

model PayoutAttempt {
  id                    String          @id @default(uuid())
  withdrawalId          String
  provider              PaymentProvider
  providerReference     String?
  providerTransactionId String?
  attemptNumber         Int
  status                TransactionStatus @default(PENDING)
  requestMetadata       Json?
  responseMetadata      Json?
  errorCode             String?
  errorMessage          String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  withdrawal            Withdrawal      @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)

  @@unique([withdrawalId, attemptNumber])
  @@unique([provider, providerReference])
  @@unique([provider, providerTransactionId])
  @@index([withdrawalId, createdAt])
  @@index([provider, providerReference])
  @@index([provider, providerTransactionId])
  @@index([status, createdAt])
}

model ProviderWebhookEvent {
  id                    String                    @id @default(uuid())
  provider              PaymentProvider
  eventId               String
  eventType             String
  providerReference     String?
  providerTransactionId String?
  withdrawalId          String?
  receivedAt            DateTime                  @default(now())
  processedAt           DateTime?
  status                ProviderWebhookEventStatus @default(RECEIVED)
  errorMessage          String?
  metadata              Json?
  withdrawal            Withdrawal?               @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)

  @@unique([provider, eventId])
  @@index([withdrawalId, receivedAt])
  @@index([provider, providerReference])
  @@index([provider, providerTransactionId])
  @@index([status, receivedAt])
}

enum DepositStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  CANCELLED
  REFUNDED
  REVERSED
  EXPIRED
  UNDER_REVIEW
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  CANCELLED
  REFUNDED
  REVERSED
  EXPIRED
  UNDER_REVIEW
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  FEE
  REFUND
  REVERSAL
  PURCHASE
  BONUS
  ADJUSTMENT
}

enum PaymentProvider {
  FLUTTERWAVE
  MANUAL
  INTERNAL
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  USSD
  MOBILE_MONEY
  WALLET_TRANSFER
  APPLE_PAY
  GOOGLE_PAY
  WISE
  OTHER
}

enum LedgerEntryType {
  CREDIT
  DEBIT
  HOLD
  RELEASE
  FEE
  REFUND
  REVERSAL
  ADJUSTMENT
}

enum WithdrawalQuoteStatus {
  ACTIVE
  USED
  EXPIRED
}

enum BeneficiaryType {
  BANK_ACCOUNT
  MOBILE_MONEY
}

enum BeneficiaryVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  FAILED
}

enum ProviderWebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum UserRole {
  USER
  ADMIN
}
